[Unit]
Description=sideload-pi IPA refresh
After=network-online.target usbmuxd.service
Wants=network-online.target

[Service]
Type=simple
Environment=SIDELOAD_PI_CONFIG=/etc/sideload-pi/config.json
ExecStart=/usr/local/bin/sideload-pi daemon
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
