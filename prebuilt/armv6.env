# Fast-path tarball for scripts/install.sh. These two values name the published
# release. install.sh compiles from source when either line is empty.
#
# Download URL, once both lines are set:
#   https://github.com/Ph-ill/pi-sideloader/releases/download/${PREBUILT_TAG}/sideload-pi-prebuilt-armv6.tar.gz
#
# PREBUILT_SHA256 is the hex digest only (64 characters), not the filename.
# It must equal the published release asset. That asset is the workflow
# artifact of the tagged commit, not a second build. See docs/SETUP.md.
PREBUILT_TAG=prebuilt-2026-11-24
PREBUILT_SHA256=3190c6320afca977bbbd72ba68643fdd61ca43f9dbf14b82feb96443d009d1a5
